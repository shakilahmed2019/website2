# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and metadata.
APP_URL="MY_APP_URL"

# VITE_YOUTUBE_API_KEY: Optional public browser key (HTTP-referrer restricted) for YouTube Data API v3.
# When omitted, the app automatically falls back to YouTube RSS via JSON proxy.
VITE_YOUTUBE_API_KEY=""
